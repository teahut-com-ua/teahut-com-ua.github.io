---
import MainLayout from '../layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from "astro:content";
import TeaCard from '../components/TeaCard.astro';
import BlogPost from '../components/BlogPost.astro';

import Image1 from "/src/assets/articles/tea-wayfarer.jpg";

const newPosts = (await getCollection('library'))
	.filter((post) => post.data.posted !== false)
	.sort(
		(a, b) => b.data.postedDate.valueOf() - a.data.postedDate.valueOf())
	.slice(0, 2);

const newTeas = (await getCollection('teas'))
	.filter((tea) => tea.data.posted !== false)
	.sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const newTeawares = (await getCollection('teawares'))
	.filter((teaware) => teaware.data.posted !== false)
	.sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const colorRed = "hsl(13, 100%, 87%)";
const colorOrange = "hsl(27, 98%, 84%)";
const colorYellow = "hsl(46, 83%, 80%)";
const colorGreen = "hsl(66, 45%, 79%)";
const colorCyan = "hsl(158, 47%, 83%)";
const colorBlue = "hsl(199, 42%, 84%)";
const colorPurple = "hsl(274, 27%, 88%)";
const colorMagenta = "hsl(345, 88%, 90%)";
---

<MainLayout>
	<h1 class="">Ласкаво просимо</h1>
	<h3>до нашої</h3>
	<h2 class="last-line">Чайної Хатинки!</h2>
	<p>
		<Image class="float-left" src={Image1} alt="Чайний мандрівник" />
		
		Кожен із нас шукає своєї досконалости так, як він чи вона розуміє її, залежно від загального знання і контексту, отриманого за своє життя, разом із тим, що закладено в нас Матінкою Природою... <br /> <br />
		<span style="font-size: 1.5em;">М</span>и, як і багато хто до нас, шукаємо Довершености у своєму житті через Чай — через ту Традицію, підвалини якої було закладено ще сивої давнини. Ми не прагнемо відкрити щось нове, досі невідоме. Навпаки, за допомогою простих метод ми глибше занурюємось у навколишнє — у те, що маємо саме цієї миті. Якщо Надзвичайне й існує, воно мусить бути тут і зараз... <span style="font-style: italic;">«Стара хвіртка до Мудрости завжди відкрита. Дзен не має дверей...»</span>
	</p>
	<p class="last-line">
		Так само як і кожна чайна людина минулого й сьогодення, ми не прагнемо віднайти досконалість заради себе. Наша Традиція — це служіння людству через Чай. <span style="font-style: italic;">"Чай і Чань (Дзен)"</span>, казали давні, <span style="font-style: italic;">"мають один смак"</span>. Із глибоким усвідомленням наших зв'язків одне з одним проголошуємо:<br /> <span style="font-weight: 600;">«Най кожна чаша з любов'ю сприяє пробудженню і присутності, розкриттю гармонії і спокою Всесвіту в людській свідомості!»</span>
	</p>

	
	<section style="padding-top: 2rem;" class="full-width">
		<div class="note-section">
			<article class="sticky-note-wrapper" data-rotate="3">
				<div class="sticky-note-content"  data-color={colorYellow}>
					<h5>White Stork</h5>
					<p>Quite a big bird! They don't have traditional voice boxes and so instead make sounds by chattering their bills together.</p>
				</div>
			</article>
			
			<article class="sticky-note-wrapper" data-rotate="-5">
				<div class="sticky-note-content" data-color={colorRed}>
					<h5>Western Cattle-Egret</h5>
					<p>Opportunistic feeders that can be found following (or standing on) cattle and sheep. They know it’s snack time when a tractor disturbs the field.</p>
				</div>
			</article>
			
			<article class="sticky-note-wrapper" data-rotate="7">
				<div class="sticky-note-content" data-color={colorBlue}>
					<h5>Zitting Cisticola</h5>
					<p>Super small, super cute! They have a very bouncy flight pattern and make a lil squeak with each flap.</p>
				</div>
			</article>
		</div>

		<h2 class="new-posts-header">Найновіші статті:</h2>
		<div class="new-posts">
			{newPosts.map((p) => 
				<BlogPost
					class="post"
					url={`/library/${p.id}/`}
					title={p.data.title}
					subtitle={p.data.subtitle}
					author={p.data.author}
					description={p.data.description}
					pubDate={p.data.pubDate}
					postedDate={p.data.postedDate}
					categoryTitle={p.data.category.title}
                	categoryUrl={p.data.category.url}
				/>)
			}
		</div>
	</section>
	<section class="tea-section breakout">
		<h2 class="last-line">Наші нові чаї:</h2>
		<div class="new-tea">
			{newTeas.map((tea) => 
				<TeaCard 
					image={tea.data.image} 
					url={`/teas/${tea.id}/`} 
					title={tea.data.title} 
					subtitle={tea.data.subtitle} 
					category={tea.data.category} 
				/>)
			}
		</div>
	</section>
	<section class="teaware-section full-width">
		<h2 class="last-line">Дещо з чайного начиння:</h2>
		<div class="new-teaware">
			{newTeawares.map((teaware) => 
				<TeaCard 
					image={teaware.data.image} 
					url={`/teawares/${teaware.id}/`} 
					title={teaware.data.title} 
					subtitle={teaware.data.subtitle} 
					category={teaware.data.category} 
				/>)
			}
		</div>
	</section>
</MainLayout>

<style>

:root {
  /* Flexoki Color Palette - 400 */
  --color-dark-50: hsla(0, 0%, 13%, 0.50);
  --color-dark-25: hsla(0, 0%, 13%, 0.25);

  --step--1: clamp(0.8333rem, 0.8101rem + 0.1159vw, 0.9rem);
  --texture-noise: url('/noise.png');
}

	h1, h2, h3 { text-align: center; }

	p::first-letter { font-size: 1.5em; }

	.new-posts-header { margin-top: 1rem; }
	
	.new-posts, .tea-section, .teaware-section { padding: 1rem; }

	.full-width {
		background: var(--button);
	}

	.note-section {
		display: none;
		flex-wrap: wrap;
		justify-content: space-evenly;
		align-items: flex-start;
		margin-bottom: 2rem;
	}
	
	.new-posts {
		display: grid;
		grid-auto-flow: dense;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
		grid-template-rows: 1fr auto;
		gap: 2em;
		margin-bottom: .5rem;
	}

	.new-tea, .new-teaware {
		display: flex;
		flex-wrap: wrap;
		gap: 2em;
		place-content: start center;
	}

.sticky-note-wrapper {
  --note-rotate: deg;
  --note-color: hsl(61, 100%, 81%);
  
  position: relative;
  transform: perspective(1px) rotate(attr(data-rotate deg));

  &::before {
    position: absolute;
    inset: 0;
    content: '';
    background: var(--color-dark-25);
    border-radius:0 0 100px/5px 0;
    filter: blur(2px);
  }

  .sticky-note-content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1em;
    
    font-size: var(--step--1);
    padding: 1em;
    aspect-ratio: 1 / 1;
    min-width: 280px;
    width: min-content;
    
    color: var(--color-dark);
    background-color: attr(data-color type(<color>));
    background-image: var(--texture-noise),
    	linear-gradient(165deg, transparent 84%, var(--color-dark-25) 100%);
    
    border-radius: 0 0 75%/10% 0; 

    border-bottom: solid 2px var(--color-dark-50);
    outline: solid 1px var(--color-dark-25);
    outline-offset: -1px;
    
    box-shadow: 0px 5px 10px var(--color-dark-25);

	& h5 {
		color: var(--foreground);
	}

	& p {
		color: var(--footer-light);
	}
  }
}


	@media screen  and (min-width: 48rem){		
		.new-tea, .new-teaware {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			grid-template-rows: 1fr;
		}
	}
</style>